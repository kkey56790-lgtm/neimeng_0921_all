# 识别器选择：yolov8 或 rknn。一次只启动一个。
# yolov8 使用COCO 80类模型，truck类别为7；rknn使用原10类best_truck模型。
# 复制本文件到 /etc/neimeng_xunjian/yolo.env。
# RKNN_PYTHON留空时使用当前已激活环境的python3；需要固定时填写绝对路径。
# RKNN_PYTHON=/absolute/path/to/python3
YOLO_BACKEND=rknn
YOLOV8_RKNN_MODEL="${SCRIPT_DIR}/models/yolov8n.rknn"
RKNN_TRUCK_MODEL="${SCRIPT_DIR}/models/best_truck.rknn"
YOLO_CONF_THRESHOLD=0.35
YOLO_ZMQ_ADDRESS=tcp://127.0.0.1:5566
# 1=独立YOLO窗口；0=无桌面后台运行。视频不会接入ROS UI。
YOLO_DISPLAY=1
# 1号车云台同时提供RTSP视频；其余RTSP参数沿用现场默认值。
RTSP_HOST=192.168.2.64
# RTSP_PORT=554
# RTSP_CHANNEL=102
# RTSP_USERNAME=admin
# RTSP_PASSWORD='真实密码'
