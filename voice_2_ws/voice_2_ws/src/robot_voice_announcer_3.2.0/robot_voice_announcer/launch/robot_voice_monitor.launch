<launch>
  <arg name="config" default="$(find robot_voice_announcer)/config/voice_monitor.yaml"/>
  <arg name="robot_ip" default="192.168.2.100"/>
  <arg name="robot_port" default="7999"/>

  <node pkg="robot_voice_announcer"
        type="robot_voice_monitor.py"
        name="robot_voice_announcer"
        output="screen"
        respawn="true"
        respawn_delay="2">
    <rosparam command="load" file="$(arg config)"/>
    <param name="robot_ip" value="$(arg robot_ip)"/>
    <param name="robot_port" value="$(arg robot_port)"/>
  </node>
</launch>
