<?xml version="1.0"?>
<package format="2">
  <name>robot_voice_announcer</name>
  <version>3.2.0</version>
  <description>MQTT voice-package bridge, HTTP V2.4 manager and state announcer.</description>
  <maintainer email="robot@example.com">Robot Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
